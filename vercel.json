{
        "version": 2,
        "cleanUrls": true,
        "functions": {
                "api/gemini.js": {
                        "maxDuration": 60
                }
        },
        "rewrites": [
                {
                        "source": "/login",
                        "destination": "/login.html"
                },
                {
                        "source": "/",
                        "destination": "/home.html"
                },
                {
                        "source": "/home",
                        "destination": "/home.html"
                },
                {
                        "source": "/profile",
                        "destination": "/DWD/profile/index.html"
                },
                {
                        "source": "/materials",
                        "destination": "/DWD/materials/index.html"
                },
                {
                        "source": "/Ai-Nano",
                        "destination": "/DWD/Ai-Nano/exams/index.html"
                },
                {
                        "source": "/professor",
                        "destination": "/DWD/schedule/professor.html"
                },
                {
                        "source": "/DWD/schedule",
                        "destination": "/DWD/schedule/index.html"
                },
                {
                        "source": "/schedule",
                        "destination": "/DWD/schedule/index.html"
                },
                {
                        "source": "/downloads",
                        "destination": "/DWD/downloads/index.html"
                },
                {
                        "source": "/attendance",
                        "destination": "/DWD/attendance/index.html"
                },
                {
                        "source": "/privacy-policy",
                        "destination": "/DWD/attendance/privacy-policy.html"
                },
                {
                        "source": "/news",
                        "destination": "/DWD/news/index.html"
                },
                {
                        "source": "/training",
                        "destination": "/DWD/training-weeks/index.html"
                },
                {
                        "source": "/about",
                        "destination": "/DWD/about/index.html"
                },
                {
                        "source": "/student-view",
                        "destination": "/DWD/schedule/student-view.html"
                },
                {
                        "source": "/admin",
                        "destination": "/DWD/schedule/admin.html"
                },
                {
                        "source": "/admin-dashboard",
                        "destination": "/DWD/schedule/admin-dashboard.html"
                },
                {
                        "source": "/grading",
                        "destination": "/DWD/schedule/grading.html"
                },
                {
                        "source": "/grades-dashboard",
                        "destination": "/DWD/schedule/grades-dashboard.html"
                },
                {
                        "source": "/api/auth/batu-login",
                        "destination": "/api/auth/batu-login.js"
                }
        ],

        "headers": [
                {
                        "source": "/(.*)",
                        "headers": [
                                {
                                        "key": "X-Frame-Options",
                                        "value": "DENY"
                                },
                                {
                                        "key": "X-Content-Type-Options",
                                        "value": "nosniff"
                                },
                                {
                                        "key": "Referrer-Policy",
                                        "value": "strict-origin-when-cross-origin"
                                },
                                {
                                        "key": "X-XSS-Protection",
                                        "value": "1; mode=block"
                                },
                                {
                                        "key": "Permissions-Policy",
                                        "value": "camera=(), microphone=*, geolocation=(self), payment=()"
                                },
                                {
                                        "key": "Strict-Transport-Security",
                                        "value": "max-age=31536000; includeSubDomains; preload"
                                },
                                {
                                        "key": "Content-Security-Policy",
                                        "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://*.gstatic.com https://www.google.com https://www.gstatic.com/recaptcha/ https://www.google.com/recaptcha/ https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https: https://placehold.co; media-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://*.gstatic.com https://firebasestorage.googleapis.com https://*.supabase.co https://*.supabase.com wss://*.supabase.co wss://*.supabase.com https://www.google.com https://generativelanguage.googleapis.com https://cdn.jsdelivr.net https://va.vercel-scripts.com https://unpkg.com https://content-firebaseappcheck.googleapis.com https://*.cartocdn.com https://*.arcgisonline.com https://ui-avatars.com https://placehold.co https://cdnjs.cloudflare.com https://cdn.tailwindcss.com https://dwd-it.app.n8n.cloud; frame-src 'self' https://www.google.com https://www.recaptcha.net https://www.youtube.com https://youtube.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
                                },
                                {
                                        "key": "X-DNS-Prefetch-Control",
                                        "value": "on"
                                },
                                {
                                        "key": "X-Robots-Tag",
                                        "value": "index, follow"
                                },
                                {
                                        "key": "Service-Worker-Allowed",
                                        "value": "/"
                                }
                        ]
                },
                {
                        "source": "/sw.js",
                        "headers": [
                                {
                                        "key": "Cache-Control",
                                        "value": "no-cache, no-store, must-revalidate"
                                },
                                {
                                        "key": "Service-Worker-Allowed",
                                        "value": "/"
                                }
                        ]
                },
                {
                        "source": "/api/(.*)",
                        "headers": [
                                {
                                        "key": "Cache-Control",
                                        "value": "no-store, no-cache, must-revalidate"
                                }
                        ]
                }
        ],
        "trailingSlash": false
}