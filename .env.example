# ⚠️ CRITICAL: This file should NEVER be committed to Git!
# Add .env to .gitignore

# Firebase Configuration
# NOTE: Firebase API Key is safe to expose in client-side code
# BUT you should still restrict it in Firebase Console

VITE_FIREBASE_API_KEY=REPLACE_WITH_YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_YOUR_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=REPLACE_WITH_YOUR_MEASUREMENT_ID

# Gemini API Key (CRITICAL - DO NOT EXPOSE)
# Store this in Vercel environment variables only, never in client code
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# Supabase (server-side)
SUPABASE_URL=REPLACE_WITH_YOUR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_KEY

# BATU SSO Secret (server-side only)
BATU_SSO_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_MIN_32_CHARS

# Firebase Admin (server-side only)
FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY=REPLACE_WITH_YOUR_FIREBASE_PRIVATE_KEY
